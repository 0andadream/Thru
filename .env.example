# ---------------------------------------------------------------------------
# Thru Onboard — environment configuration
# Copy this file to `.env.local` and fill in the values for your network.
# Every NEXT_PUBLIC_* value is safe to expose to the browser (no secrets here —
# private keys are ONLY ever generated and stored client-side).
# ---------------------------------------------------------------------------

# --- Network -----------------------------------------------------------------
# Thru RPC endpoint the browser talks to directly (gRPC-web).
NEXT_PUBLIC_THRU_RPC_URL=https://rpc.alphanet.thru.org

# Human-readable network name shown in the UI.
NEXT_PUBLIC_THRU_NETWORK=Alphanet

# Block explorer base URL. Address/tx paths are appended (see lib/thru/explorer.ts).
NEXT_PUBLIC_THRU_EXPLORER_URL=https://explorer.alphanet.thru.org

# --- Faucet ------------------------------------------------------------------
# Thru's faucet is an ON-CHAIN program claimed with the `thru` CLI
# (`thru faucet withdraw <account> <amount>`) — there is no public HTTP faucet.
# The Fund step therefore guides users through the CLI (pre-filled with their
# key) by default, and auto-detects the balance landing.
#
# OPTIONAL: if your team runs its own HTTP faucet gateway (a service that takes
# an address and dispenses tokens), set its URL here to enable an extra
# one-click button. The app calls it via a rate-limited server proxy
# (/api/faucet). Leave blank to rely on the CLI flow only.
FAUCET_URL=

# Amount to request per faucet withdraw (base units; the CLI caps at 10000/tx).
NEXT_PUBLIC_FAUCET_AMOUNT=10000
NEXT_PUBLIC_FAUCET_AMOUNT_LABEL=10,000 units

# Max gateway faucet requests allowed per IP per hour (server-side rate limit).
FAUCET_RATE_LIMIT_PER_HOUR=3

# --- On-chain programs -------------------------------------------------------
# Address of the Token program on your network. Required for the "Launch a
# Token" deploy option. Leave blank to disable that option gracefully.
NEXT_PUBLIC_TOKEN_PROGRAM_ADDRESS=

# Address of the Name Service program. Required to actually register names
# on-chain in step 5. Leave blank to run that step in preview mode (derives
# and shows the name addresses without submitting).
NEXT_PUBLIC_NAME_SERVICE_PROGRAM_ADDRESS=

# Address of the program loader used to deploy raw program binaries
# (Counter / Hello World sample programs). Leave blank to disable those
# deploy options gracefully.
NEXT_PUBLIC_PROGRAM_LOADER_ADDRESS=

# --- Chain params ------------------------------------------------------------
# Chain id used when building transactions.
NEXT_PUBLIC_THRU_CHAIN_ID=1
