# ---------------------------------------------------------------------------
# Thru Onboard — environment configuration
# Copy this file to `.env.local` and fill in the values for your network.
# Every NEXT_PUBLIC_* value is safe to expose to the browser (no secrets here —
# private keys are ONLY ever generated and stored client-side).
# ---------------------------------------------------------------------------

# --- Network -----------------------------------------------------------------
# Thru RPC endpoint the browser talks to directly (gRPC-web).
NEXT_PUBLIC_THRU_RPC_URL=https://rpc.alphanet.thru.org

# Human-readable network name shown in the UI.
NEXT_PUBLIC_THRU_NETWORK=Alphanet

# Block explorer base URL. Address/tx paths are appended (see lib/thru/explorer.ts).
NEXT_PUBLIC_THRU_EXPLORER_URL=https://scan.thru.org

# --- Faucet ------------------------------------------------------------------
# The primary funding path submits Thru's on-chain faucet withdraw instruction
# directly from the browser. These server options are optional alternatives.
#
# (A) BUILT-IN RELAYER ---------------------------------------------------------
# Give the server the official `thru` CLI + a FUNDED operator key. On each
# request the server runs `thru faucet withdraw <userAddress> <amount>` with the
# operator as fee payer, so tokens are sent to the user's address and the
# operator pays the fee. The operator key is a SERVER SECRET and never reaches
# the browser. Requires a host that can run the ~360MB `thru` binary (any small
# VM/container — not Vercel's serverless functions; on Vercel use option B and
# run this relayer as a separate tiny service).
#
#   THRU_CLI_BIN            path to the `thru` binary (or "thru" if on PATH)
#   THRU_FAUCET_OPERATOR_KEY  64-hex private key of a funded account (secret!)
#   THRU_RPC_URL           RPC the relayer submits to (defaults to the public one)
#   THRU_FAUCET_AMOUNT     amount per claim (base units; CLI caps at 10000/tx)
THRU_CLI_BIN=
THRU_FAUCET_OPERATOR_KEY=
THRU_RPC_URL=
THRU_FAUCET_AMOUNT=10000

# (B) EXTERNAL HTTP GATEWAY (optional) ----------------------------------------
# If you already run an HTTP faucet service that takes { address } and dispenses
# tokens, set its URL here. The app proxies to it via /api/faucet.
FAUCET_URL=

# Browser faucet amount and label.
NEXT_PUBLIC_FAUCET_AMOUNT=10000
NEXT_PUBLIC_FAUCET_AMOUNT_LABEL=10,000 units
NEXT_PUBLIC_COMMUNITY_FAUCET_URL=https://faucet.thruscan.net

# Max one-click faucet requests allowed per IP per hour (server-side rate limit).
FAUCET_RATE_LIMIT_PER_HOUR=3

# --- On-chain programs -------------------------------------------------------
# Official Alphanet Token Program.
NEXT_PUBLIC_TOKEN_PROGRAM_ADDRESS=taAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAKqq

# Address of the Name Service program. Required to actually register names
# on-chain in step 5. Leave blank to run that step in preview mode (derives
# and shows the name addresses without submitting).
NEXT_PUBLIC_NAME_SERVICE_PROGRAM_ADDRESS=taAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAUF

# --- Chain params ------------------------------------------------------------
# Chain id used when building transactions.
NEXT_PUBLIC_THRU_CHAIN_ID=1
